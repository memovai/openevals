# TypeSafe (jev) — required for evaluation; without it traces are still recorded.
TYPESAFE_API_KEY=
OPENEVA_JEV_MODEL=jev-latest

# Server
OPENEVA_PORT=3100
OPENEVA_DB=./data/openeva.db
# Optional: if set, ingestion + REST require `Authorization: Bearer <key>` (or Basic <anything>:<key>)
OPENEVA_API_KEY=

# Eval worker
OPENEVA_EVAL_ENABLED=true
OPENEVA_SETTLE_MS=5000          # wait this long after the last event before judging a trace
OPENEVA_STATE_BUDGET_CHARS=90000 # ~22k tokens; jev allows 32k for state + longest question
OPENEVA_REVIEW_CONFIDENCE=0.5   # judgments with min confidence below this are flagged needs_review

# Escalation: when jev's min confidence < OPENEVA_REVIEW_CONFIDENCE (or a Noul lands within
# OPENEVA_ESCALATE_NOUL_BAND of 0.5), re-ask the same questions to a reasoning model with rationale.
ANTHROPIC_API_KEY=
OPENEVA_ESCALATE=true
OPENEVA_ESCALATE_MODEL=claude-opus-5
OPENEVA_ESCALATE_NOUL_BAND=0.15
