# TypeSafe (jev) — required for evaluation; without it traces are still recorded.
TYPESAFE_API_KEY=
OPENEVALS_JEV_MODEL=jev-latest

# Server
OPENEVALS_PORT=3100
OPENEVALS_DB=./data/openevals.db
# Optional: if set, ingestion + REST require `Authorization: Bearer <key>` (or Basic <anything>:<key>)
OPENEVALS_API_KEY=

# Eval worker
OPENEVALS_EVAL_ENABLED=true
OPENEVALS_SETTLE_MS=5000          # wait this long after the last event before judging a trace
OPENEVALS_STATE_BUDGET_CHARS=90000 # ~22k tokens; jev allows 32k for state + longest question
OPENEVALS_REVIEW_CONFIDENCE=0.5   # judgments with min confidence below this are flagged needs_review

# Escalation: when jev's min confidence < OPENEVALS_REVIEW_CONFIDENCE (or a Noul lands within
# OPENEVALS_ESCALATE_NOUL_BAND of 0.5), re-ask the same questions to a reasoning model with rationale.
ANTHROPIC_API_KEY=
OPENEVALS_ESCALATE=true
OPENEVALS_ESCALATE_MODEL=claude-opus-5
OPENEVALS_ESCALATE_NOUL_BAND=0.15

# Per-step grading (the `step` evaluator): concurrency within a trace, max steps judged per trace (sampled evenly beyond), previous steps in each step's context
# OPENEVALS_STEP_CONCURRENCY=8
# OPENEVALS_STEP_MAX=150
# OPENEVALS_STEP_CONTEXT=8
# Rubric compiler model (POST /api/v1/evaluators/compile; needs ANTHROPIC_API_KEY)
# OPENEVALS_COMPILE_MODEL=claude-sonnet-5
